<odoo>
    <record id="mis_cash_flow_access_name" model="ir.model.access">
        <field name="name">mis.cash_flow</field>
        <field name="model_id" ref="model_mis_cash_flow" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>
    <record id="mis_cash_flow_forecast_line_access_name" model="ir.model.access">
        <field name="name">mis.cash_flow.forecast_line</field>
        <field name="model_id" ref="model_mis_cash_flow_forecast_line" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
    <record id="access_cash_flow_plan" model="ir.model.access">
        <field name="name">mis.cash.flow.plan</field>
        <field name="model_id" ref="model_mis_cash_flow_plan" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
    <record id="cash_flow_plan_company_rule" model="ir.rule">
        <field name="name">mis.cash_flow.plan:Company</field>
        <field name="model_id" ref="model_mis_cash_flow_plan" />
        <field
            name="domain_force"
        >['|',('company_id','=',False),('company_id', 'parent_of', company_ids)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
